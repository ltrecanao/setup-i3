# X Profile — Tema Aura

# Cursor
xsetroot -cursor_name left_ptr
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# DPI
export GDK_SCALE=1
export GDK_DPI_SCALE=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1

# Teclado
setxkbmap -layout latam
xset r rate 300 50

# Bell
xset -b

# Screen blanking
xset s 600 600
xset dpms 600 600 600
